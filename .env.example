# Option A: a single connection string (Neon, Render, Railway, etc. all
# use this format). Takes priority over the PG* variables below if set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: discrete variables, for local development
PGHOST=localhost
PGPORT=5432
PGDATABASE=fraud_detection
PGUSER=fraud_app
PGPASSWORD=changeme

# API security. SECRET_KEY signs login tokens and is REQUIRED: the API refuses
# to start without it (unless FLASK_DEBUG=true, which uses a development-only
# key). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Admin login. Set ADMIN_PASSWORD_HASH (preferred; make one with
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# ) or ADMIN_PASSWORD. If neither is set, the public demo password "admin" is
# used and a warning is logged. ADMIN_USERNAME defaults to "admin".
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# Architecture benchmark (benchmark_db.py / benchmark_architectures.py).
# PG_BIN is PostgreSQL's bin directory, if its tools are not on PATH;
# BENCH_DATABASE_URL is written to .env by `python benchmark_db.py init`.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# BENCH_DATABASE_URL=postgresql://postgres:password@localhost:5433/fraud_bench
