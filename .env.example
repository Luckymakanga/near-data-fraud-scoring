# Option A: a single connection string (Neon, Render, Railway, etc. all
# use this format). Takes priority over the PG* variables below if set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: discrete variables, for local development
PGHOST=localhost
PGPORT=5432
PGDATABASE=fraud_detection
PGUSER=fraud_app
PGPASSWORD=changeme

# Architecture benchmark (benchmark_db.py / benchmark_architectures.py).
# PG_BIN is PostgreSQL's bin directory, if its tools are not on PATH;
# BENCH_DATABASE_URL is written to .env by `python benchmark_db.py init`.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# BENCH_DATABASE_URL=postgresql://postgres:password@localhost:5433/fraud_bench
